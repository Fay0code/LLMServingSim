        </mxCell>
        <mxCell id="chat" value="&lt;b&gt;Agent 页面&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:20px;color:#51647B;'&gt;提交请求 / 展示进度&lt;br&gt;显示回答与证据链接&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#2864BC;fillColor=#FFFFFF;fontSize=24;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="ui">
