          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="passed" edge="1" parent="1" source="correct" target="benchmark" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.4;strokeColor=#2864BC;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;dashed=0;">
