        </mxCell>
        <mxCell id="p1" edge="1" parent="1" source="readresult" target="evidence" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.4;strokeColor=#AA6325;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;dashed=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2" edge="1" parent="1" source="evidence" target="explain" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.4;strokeColor=#AA6325;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;dashed=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3" edge="1" parent="1" source="explain" target="decide" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.4;strokeColor=#AA6325;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;dashed=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="next_tick" edge="1" parent="1" source="decide" target="prepare" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.4;strokeColor=#087E83;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;dashed=0;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1520" y="1100" />
              <mxPoint x="55" y="1100" />
              <mxPoint x="55" y="305" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="title" value="ServingStudio 工作流：Tick → Tock → Probe" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=38;fontColor=#152C48;fontStyle=1;fontFamily=Arial Unicode MS;" vertex="1" parent="1">
          <mxGeometry x="55" y="25" width="1690" height="62" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="按编号沿箭头阅读；Agent 指 Orchestrator，Implementer 单独标出。Analyzer 是分析工具，不是另一个 Agent。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontColor=#51647B;fontStyle=0;fontFamily=Arial Unicode MS;" vertex="1" parent="1">
          <mxGeometry x="55" y="95" width="1690" height="48" as="geometry" />
        </mxCell>
        <mxCell id="ticklabel" value="Tick  →  用仿真证据确定一个修改任务" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=25;fontColor=#087E83;fontStyle=1;fontFamily=Arial Unicode MS;" vertex="1" parent="tick">
          <mxGeometry x="22" y="15" width="1576" height="40" as="geometry" />
        </mxCell>
        <mxCell id="prepare" value="&lt;b&gt;1  Agent：准备仿真&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:21px;color:#51647B;'&gt;指定模型 / 负载 / 硬件&lt;br&gt;确认仿真支持范围&lt;br&gt;调用仿真工具&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#087E83;fillColor=#FFFFFF;fontSize=24;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="tick">
          <mxGeometry x="35" y="70" width="320" height="150" as="geometry" />
        </mxCell>
        <mxCell id="simulate" value="&lt;b&gt;2  ServingStudio Sim&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:21px;color:#51647B;'&gt;执行仿真 / 时间预测&lt;br&gt;生成运行日志与成本数据&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#087E83;fillColor=#FFFFFF;fontSize=24;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="tick">
          <mxGeometry x="445" y="70" width="320" height="150" as="geometry" />
        </mxCell>
        <mxCell id="analyze" value="&lt;b&gt;3  Analyzer&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:20px;color:#51647B;'&gt;读取仿真产物&lt;br&gt;输出吞吐 / 延迟 / KV 等报告&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#087E83;fillColor=#FFFFFF;fontSize=24;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="tick">
          <mxGeometry x="855" y="70" width="320" height="150" as="geometry" />
        </mxCell>
        <mxCell id="freeze" value="&lt;b&gt;4  Agent：选定改动&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:21px;color:#51647B;'&gt;解读报告，冻结一个假设&lt;br&gt;明确修改范围与验收要求&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#087E83;fillColor=#FFFFFF;fontSize=24;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="tick">
          <mxGeometry x="1265" y="70" width="320" height="150" as="geometry" />
        </mxCell>
        <mxCell id="runlabel" value="调用" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontColor=#087E83;fontStyle=0;fontFamily=Arial Unicode MS;" vertex="1" parent="tick">
          <mxGeometry x="360" y="101" width="80" height="28" as="geometry" />
        </mxCell>
        <mxCell id="logslabel" value="日志" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontColor=#087E83;fontStyle=0;fontFamily=Arial Unicode MS;" vertex="1" parent="tick">
          <mxGeometry x="770" y="101" width="80" height="28" as="geometry" />
        </mxCell>
        <mxCell id="reportlabel" value="报告" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontColor=#087E83;fontStyle=0;fontFamily=Arial Unicode MS;" vertex="1" parent="tick">
          <mxGeometry x="1180" y="101" width="80" height="28" as="geometry" />
        </mxCell>
        <mxCell id="tocklabel" value="Tock  ←  实现本轮改动，检查正确性并测量" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=25;fontColor=#2864BC;fontStyle=1;fontFamily=Arial Unicode MS;" vertex="1" parent="tock">
          <mxGeometry x="22" y="15" width="1576" height="40" as="geometry" />
        </mxCell>
        <mxCell id="patch" value="&lt;b&gt;5  Implementer：实现&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:20px;color:#51647B;'&gt;按任务修改代码 / 策略&lt;br&gt;工作区保留修改产物&lt;br&gt;返回 summary 与检查证据&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#2864BC;fillColor=#FFFFFF;fontSize=24;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="tock">
          <mxGeometry x="1265" y="75" width="320" height="150" as="geometry" />
        </mxCell>
        <mxCell id="review" value="&lt;b&gt;6  Agent：审查改动&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:21px;color:#51647B;'&gt;读取 summary 与实际 diff&lt;br&gt;启动可信检查 / 验证命令&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#2864BC;fillColor=#FFFFFF;fontSize=24;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="tock">
          <mxGeometry x="855" y="75" width="320" height="150" as="geometry" />
        </mxCell>
        <mxCell id="correct" value="&lt;b&gt;7  正确性检查&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:21px;color:#51647B;'&gt;运行修改后的代码&lt;br&gt;检查输出与本轮约束&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#2864BC;fillColor=#FFFFFF;fontSize=24;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="tock">
          <mxGeometry x="445" y="75" width="320" height="150" as="geometry" />
        </mxCell>
        <mxCell id="benchmark" value="&lt;b&gt;8  Benchmark 测量&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:20px;color:#51647B;'&gt;Agent 发起标准性能测试&lt;br&gt;保存吞吐 / 延迟等实测结果&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#2864BC;fillColor=#FFFFFF;fontSize=24;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="tock">
          <mxGeometry x="35" y="75" width="320" height="150" as="geometry" />
        </mxCell>
        <mxCell id="tasklabel" value="task：委派实现" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontColor=#2864BC;fontStyle=0;fontFamily=Arial Unicode MS;" vertex="1" parent="1">
          <mxGeometry x="1535" y="423" width="150" height="30" as="geometry" />
        </mxCell>
        <mxCell id="summarylabel" value="summary" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=17;fontColor=#2864BC;fontStyle=0;fontFamily=Arial Unicode MS;" vertex="1" parent="tock">
          <mxGeometry x="1178" y="107" width="85" height="28" as="geometry" />
        </mxCell>
        <mxCell id="checklabel" value="运行" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontColor=#2864BC;fontStyle=0;fontFamily=Arial Unicode MS;" vertex="1" parent="tock">
          <mxGeometry x="770" y="107" width="80" height="28" as="geometry" />
        </mxCell>
        <mxCell id="passlabel" value="通过" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontColor=#2864BC;fontStyle=0;fontFamily=Arial Unicode MS;" vertex="1" parent="tock">
          <mxGeometry x="360" y="107" width="80" height="28" as="geometry" />
        </mxCell>
        <mxCell id="repairlabel" value="未通过：Agent 反馈失败原因 → 再委派 Implementer 修复" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=19;fontColor=#AA6325;fontStyle=0;fontFamily=Arial Unicode MS;" vertex="1" parent="tock">
          <mxGeometry x="645" y="232" width="690" height="30" as="geometry" />
        </mxCell>
        <mxCell id="probelabel" value="Probe  →  解释结果，决定是否保留，再进入下一轮" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=25;fontColor=#AA6325;fontStyle=1;fontFamily=Arial Unicode MS;" vertex="1" parent="probe">
          <mxGeometry x="22" y="15" width="1576" height="40" as="geometry" />
        </mxCell>
        <mxCell id="readresult" value="&lt;b&gt;9  Agent：核对结果&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:20px;color:#51647B;'&gt;读取实测结果与仿真目标&lt;br&gt;先核对比较前提与偏差方向&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#AA6325;fillColor=#FFFFFF;fontSize=24;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="probe">
          <mxGeometry x="35" y="70" width="320" height="150" as="geometry" />
        </mxCell>
        <mxCell id="evidence" value="&lt;b&gt;10  分析 / 诊断工具&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:20px;color:#51647B;'&gt;优先读取已有分析产物&lt;br&gt;不足时再 profiling / 采样&lt;br&gt;返回对齐结果与诊断证据&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#AA6325;fillColor=#FFFFFF;fontSize=24;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="probe">
          <mxGeometry x="445" y="70" width="320" height="150" as="geometry" />
        </mxCell>
        <mxCell id="explain" value="&lt;b&gt;11  Agent：解释差异&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:20px;color:#51647B;'&gt;区分算子 / 批形状差异&lt;br&gt;与调度 / 框架开销&lt;br&gt;说明收益或退化来自哪里&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#AA6325;fillColor=#FFFFFF;fontSize=24;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="probe">
          <mxGeometry x="855" y="70" width="320" height="150" as="geometry" />
        </mxCell>
        <mxCell id="decide" value="&lt;b&gt;12  Agent：记录决策&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:21px;color:#51647B;'&gt;保留 / 拒绝 / 证据不足&lt;br&gt;记录证据与剩余优化空间&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#AA6325;fillColor=#FFFFFF;fontSize=24;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="probe">
          <mxGeometry x="1265" y="70" width="320" height="150" as="geometry" />
        </mxCell>
