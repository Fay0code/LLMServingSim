        <mxCell id="sim_results" edge="1" parent="1" source="sim" target="decision" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.4;strokeColor=#087E83;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.25;entryY=0.0;entryDx=0;entryDy=0;dashed=0;">
          <mxGeometry relative="1" as="geometry">
