        </mxCell>
        <mxCell id="mcp" value="&lt;b&gt;Analyzer MCP：一个读工具&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:19px;color:#51647B;'&gt;read_analyzer_resource(path, source)&lt;br&gt;source = host | workspace；只读 GET&lt;br&gt;返回数值结果及适用的引用信息&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#087E83;fillColor=#FFFFFF;fontSize=24;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="toolpanel">
