        <mxCell id="roleout" value="&lt;b&gt;1  Role envelope&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:21px;color:#51647B;'&gt;action + message [+ task]&lt;br&gt;控制委派 / 回交 / 结束&lt;br&gt;message 内部仍是自由文本&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#2864BC;fillColor=#FFFFFF;fontSize=25;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="outputs">
