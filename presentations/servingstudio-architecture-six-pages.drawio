        <mxCell id="cat1" value="&lt;b&gt;orchestrator-*  × 2&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:18px;color:#51647B;'&gt;规划与验证&lt;br&gt;Python profiling / Rust 接线&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#8051B3;fillColor=#FFFFFF;fontSize=25;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="1">
          <mxGeometry x="400" y="330" width="310" height="145" as="geometry" />
