        </mxCell>
        <mxCell id="summarylabel" value="summary" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontColor=#2864BC;fontStyle=0;fontFamily=Arial Unicode MS;" vertex="1" parent="agent">
          <mxGeometry x="320" y="315" width="100" height="35" as="geometry" />
        </mxCell>
        <mxCell id="skill" value="&lt;b&gt;Skills / prompts&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:20px;color:#51647B;'&gt;告诉 Agent 怎么做&lt;br&gt;不是额外 Agent&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#8051B3;fillColor=#FAF6FD;fontSize=24;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="agent">
          <mxGeometry x="30" y="405" width="285" height="100" as="geometry" />
        </mxCell>
        <mxCell id="subagents" value="&lt;b&gt;可选子 Agent × N&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:20px;color:#51647B;'&gt;Implementer 按需拆分&lt;br&gt;总数量不一定只有两个&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#6B7484;fillColor=#F6F7F9;fontSize=23;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="agent">
          <mxGeometry x="425" y="405" width="285" height="100" as="geometry" />
        </mxCell>
        <mxCell id="mode" value="&lt;b&gt;可选 single 模式：一个 Assistant 协调并实现&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:18px;color:#51647B;'&gt;Codex / Claude 是模型与工具的接入方式，不是另外两个专家&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#2864BC;fillColor=#FFFFFF;fontSize=22;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="agent">
          <mxGeometry x="30" y="545" width="680" height="65" as="geometry" />
        </mxCell>
        <mxCell id="simlabel" value="C  Sim 与分析工具" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=25;fontColor=#087E83;fontStyle=1;fontFamily=Arial Unicode MS;" vertex="1" parent="sim">
          <mxGeometry x="22" y="15" width="461" height="40" as="geometry" />
        </mxCell>
        <mxCell id="launcher" value="&lt;b&gt;Launcher + Simulator&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:20px;color:#51647B;'&gt;配置与 trace → 仿真执行 → 日志&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#087E83;fillColor=#FFFFFF;fontSize=25;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="sim">
          <mxGeometry x="30" y="80" width="445" height="95" as="geometry" />
        </mxCell>
        <mxCell id="analyzer" value="&lt;b&gt;Analyzer：不是 Agent&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:21px;color:#51647B;'&gt;确定性程序计算指标、生成图表&lt;br&gt;Orchestrator 读取结果进行判断&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#087E83;fillColor=#FFFFFF;fontSize=25;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="sim">
          <mxGeometry x="30" y="250" width="445" height="120" as="geometry" />
        </mxCell>
        <mxCell id="real" value="&lt;b&gt;真实测量与验证&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:20px;color:#51647B;'&gt;profiling / correctness / benchmark&lt;br&gt;调用真实框架与硬件，产生实测证据&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#AA6325;fillColor=#FFF8EE;fontSize=24;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="sim">
          <mxGeometry x="30" y="450" width="445" height="120" as="geometry" />
        </mxCell>
        <mxCell id="statelabel" value="Memory / 持久化状态：跨调用、跨轮次保留" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=25;fontColor=#8051B3;fontStyle=1;fontFamily=Arial Unicode MS;" vertex="1" parent="state">
          <mxGeometry x="22" y="15" width="1646" height="40" as="geometry" />
        </mxCell>
        <mxCell id="agentmemory" value="Agent 记忆：会话 / 角色 session / plan / progress&lt;br&gt;帮助恢复上下文、目标与下一步；不是模型的 KV cache" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontColor=#8051B3;fontStyle=0;fontFamily=Arial Unicode MS;" vertex="1" parent="state">
          <mxGeometry x="30" y="55" width="790" height="60" as="geometry" />
        </mxCell>
        <mxCell id="evidencestore" value="共享文件与证据：代码 / 配置 / 日志 / Analyzer 报告 / profile.db&lt;br&gt;属于持久资产；不能全部等同于语义记忆或自动学习" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=19;fontColor=#8051B3;fontStyle=0;fontFamily=Arial Unicode MS;" vertex="1" parent="state">
          <mxGeometry x="875" y="55" width="770" height="60" as="geometry" />
        </mxCell>
        <mxCell id="foot" value="依据固定源码版本：默认双角色 + 动态子 Agent；single 是替代模式。底座把 Agent 记忆与共享实验数据分别标出。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=17;fontColor=#51647B;fontStyle=0;fontFamily=Arial Unicode MS;" vertex="1" parent="1">
          <mxGeometry x="55" y="1110" width="1690" height="34" as="geometry" />
        </mxCell>
