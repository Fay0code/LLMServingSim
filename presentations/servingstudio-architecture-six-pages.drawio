        <mxCell id="real_eval" value="&lt;b&gt;真实 Serving 改动验证&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:18px;color:#51647B;'&gt;可信 correctness + 未加 profiler 的 benchmark；单独 profiling 解释原因&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#087E83;fillColor=#FFFFFF;fontSize=23;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="eval">
          <mxGeometry x="25" y="280" width="775" height="75" as="geometry" />
        </mxCell>
        <mxCell id="memorylabel" value="Memory：可恢复的状态与文件" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=25;fontColor=#8051B3;fontStyle=1;fontFamily=Arial Unicode MS;" vertex="1" parent="memory">
