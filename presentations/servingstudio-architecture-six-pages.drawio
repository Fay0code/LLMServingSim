        <mxCell id="subtitle" value="评测服务成功 ≠ 改动性能更好；可恢复会话 ≠ 自动学习出的经验库；角色 JSON ≠ 数值报告。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontColor=#51647B;fontStyle=0;fontFamily=Arial Unicode MS;" vertex="1" parent="1">
