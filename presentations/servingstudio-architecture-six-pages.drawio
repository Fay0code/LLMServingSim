        <mxCell id="to_probe" edge="1" parent="1" source="benchmark" target="readresult" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.4;strokeColor=#AA6325;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;dashed=0;">
          <mxGeometry relative="1" as="geometry">
