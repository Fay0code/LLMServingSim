        <mxCell id="title" value="Skills 指导怎么做；工具真正执行与计算" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=38;fontColor=#152C48;fontStyle=1;fontFamily=Arial Unicode MS;" vertex="1" parent="1">
          <mxGeometry x="55" y="25" width="1690" height="62" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="固定版本中 Sim/skills 有 44 个 SKILL.md。另有 Agent/SKILL.md，供外部 Agent 调用 HTTP API。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontColor=#51647B;fontStyle=0;fontFamily=Arial Unicode MS;" vertex="1" parent="1">
          <mxGeometry x="55" y="95" width="1690" height="48" as="geometry" />
        </mxCell>
        <mxCell id="entry" value="&lt;b&gt;入口：skills/skill-of-skills/SKILL.md&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:21px;color:#51647B;'&gt;Agent 先读技能地图，再选择最高匹配工作流；skills 通过链接暴露给 provider CLI&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#8051B3;fillColor=#F7F2FC;fontSize=27;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="1">
          <mxGeometry x="55" y="175" width="1690" height="85" as="geometry" />
        </mxCell>
        <mxCell id="cat0" value="&lt;b&gt;top-*  × 6&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:18px;color:#51647B;'&gt;主要任务入口&lt;br&gt;加模型 / 加 kernel / 对齐 / 优化&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#8051B3;fillColor=#FFFFFF;fontSize=25;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="1">
