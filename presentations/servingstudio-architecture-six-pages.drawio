        <mxCell id="title" value="ServingStudio：两个顶层角色，工具执行，Memory 保留状态" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=38;fontColor=#152C48;fontStyle=1;fontFamily=Arial Unicode MS;" vertex="1" parent="1">
          <mxGeometry x="55" y="25" width="1690" height="62" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="本图展开默认 orchestrated 模式。Agent 模块内有两个独立角色；实现者还可以按任务启动临时子 Agent。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontColor=#51647B;fontStyle=0;fontFamily=Arial Unicode MS;" vertex="1" parent="1">
          <mxGeometry x="55" y="95" width="1690" height="48" as="geometry" />
        </mxCell>
        <mxCell id="user" value="&lt;b&gt;用户 / 外部调用者&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:20px;color:#51647B;'&gt;提供目标、模型、负载和硬件；请求查询、实验或代码改动&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#2864BC;fillColor=#EEF5FF;fontSize=25;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="1">
