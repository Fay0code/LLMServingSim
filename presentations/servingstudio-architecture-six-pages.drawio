          <mxGeometry x="22" y="15" width="781" height="40" as="geometry" />
        </mxCell>
        <mxCell id="db" value="&lt;b&gt;SQLite + provider sessions&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:18px;color:#51647B;'&gt;conversations / messages / turns / events / jobs；角色上下文各自续接&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#8051B3;fillColor=#FFFFFF;fontSize=23;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="memory">
          <mxGeometry x="25" y="80" width="775" height="75" as="geometry" />
        </mxCell>
        <mxCell id="md" value="&lt;b&gt;会话计划与进度&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:19px;color:#51647B;'&gt;&amp;lt;cid&amp;gt;_plan.md / &amp;lt;cid&amp;gt;_progress.md；每次 call 读，关键交接后更新&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#8051B3;fillColor=#FFFFFF;fontSize=23;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="memory">
          <mxGeometry x="25" y="180" width="775" height="75" as="geometry" />
        </mxCell>
        <mxCell id="files" value="&lt;b&gt;工作区与实验资产&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:18px;color:#51647B;'&gt;Git / configs / logs / reports / plots / profile.db；不是共享完整 LLM 上下文&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#8051B3;fillColor=#FFFFFF;fontSize=23;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="memory">
          <mxGeometry x="25" y="280" width="775" height="75" as="geometry" />
        </mxCell>
        <mxCell id="outputslabel" value="Output：三层独立契约" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=25;fontColor=#2864BC;fontStyle=1;fontFamily=Arial Unicode MS;" vertex="1" parent="outputs">
