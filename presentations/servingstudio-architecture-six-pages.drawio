        </mxCell>
        <mxCell id="finish" edge="1" parent="1" source="decision" target="exit" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.4;strokeColor=#2864BC;exitX=1.0;exitY=0.5217391304347826;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5263157894736842;entryDx=0;entryDy=0;dashed=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="title" value="summary 之后：审查 → 选择验证工具 → 新证据 → 决策" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=38;fontColor=#152C48;fontStyle=1;fontFamily=Arial Unicode MS;" vertex="1" parent="1">
          <mxGeometry x="55" y="25" width="1690" height="62" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="summary 是工作交接，不是性能验证。修改模拟器就验证新仿真；修改真实框架就验证实测，不能仅靠重跑原模拟器。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontColor=#51647B;fontStyle=0;fontFamily=Arial Unicode MS;" vertex="1" parent="1">
          <mxGeometry x="55" y="95" width="1690" height="48" as="geometry" />
        </mxCell>
        <mxCell id="input" value="&lt;b&gt;Orchestrator 的输入：用户目标 + skills / 计划 + 历史进度 + 已有实验结果&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:21px;color:#51647B;'&gt;Analyzer 结果只是其中一类证据；缺少结果时，Orchestrator 先调用工具获取&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#2864BC;fillColor=#EEF5FF;fontSize=26;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="1">
          <mxGeometry x="55" y="160" width="1690" height="95" as="geometry" />
        </mxCell>
        <mxCell id="agentslabel" value="两个顶层角色；图中多个 Orchestrator 框表示同一角色的不同阶段" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=25;fontColor=#2864BC;fontStyle=1;fontFamily=Arial Unicode MS;" vertex="1" parent="agents">
          <mxGeometry x="22" y="15" width="1646" height="40" as="geometry" />
        </mxCell>
        <mxCell id="orch" value="&lt;b&gt;Orchestrator 确定任务&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:20px;color:#51647B;'&gt;给出目标、修改范围和验证标准&lt;br&gt;经运行时 delegate(task)&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#2864BC;fillColor=#FFFFFF;fontSize=25;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="agents">
          <mxGeometry x="65" y="70" width="380" height="110" as="geometry" />
        </mxCell>
        <mxCell id="impl" value="&lt;b&gt;Implementer 修改代码&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:20px;color:#51647B;'&gt;代码保存在工作区；返回 summary&lt;br&gt;说明改了什么、检查和剩余问题&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#2864BC;fillColor=#FFFFFF;fontSize=25;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="agents">
          <mxGeometry x="635" y="70" width="400" height="110" as="geometry" />
        </mxCell>
        <mxCell id="review" value="&lt;b&gt;Orchestrator 审查&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:20px;color:#51647B;'&gt;读 summary + diff，检查正确性&lt;br&gt;未通过先修复，不能只相信摘要&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#2864BC;fillColor=#FFFFFF;fontSize=25;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="agents">
          <mxGeometry x="1205" y="70" width="420" height="110" as="geometry" />
        </mxCell>
        <mxCell id="tasklabel" value="task 文本" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=19;fontColor=#2864BC;fontStyle=0;fontFamily=Arial Unicode MS;" vertex="1" parent="agents">
          <mxGeometry x="460" y="80" width="160" height="32" as="geometry" />
        </mxCell>
        <mxCell id="summarylabel" value="summary" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=19;fontColor=#2864BC;fontStyle=0;fontFamily=Arial Unicode MS;" vertex="1" parent="agents">
          <mxGeometry x="1045" y="80" width="150" height="32" as="geometry" />
        </mxCell>
        <mxCell id="repairlabel" value="未通过：给出错误 / 失败样例，再次委派" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=19;fontColor=#AA6325;fontStyle=0;fontFamily=Arial Unicode MS;" vertex="1" parent="1">
          <mxGeometry x="930" y="505" width="480" height="24" as="geometry" />
        </mxCell>
        <mxCell id="toolslabel" value="审查通过后，按修改对象选择验证路径&lt;br&gt;下方均为工具，不是新增 Agent" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontColor=#087E83;fontStyle=1;fontFamily=Arial Unicode MS;" vertex="1" parent="tools">
          <mxGeometry x="545" y="10" width="600" height="55" as="geometry" />
        </mxCell>
        <mxCell id="sim" value="&lt;b&gt;A  修改的是模拟器策略 / 执行模型&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:21px;color:#51647B;'&gt;Orchestrator 运行修改后的 Simulator&lt;br&gt;Analyzer 输出新吞吐、延迟、KV、batch 等分析&lt;br&gt;固定 workload 与比较条件，对比基线&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#087E83;fillColor=#FFFFFF;fontSize=25;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="tools">
          <mxGeometry x="65" y="80" width="690" height="150" as="geometry" />
        </mxCell>
        <mxCell id="real" value="&lt;b&gt;B  修改的是真实 serving 框架&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:20px;color:#51647B;'&gt;Orchestrator 运行可信 correctness → 真机 benchmark&lt;br&gt;必要时 profiling / 对齐分析；获得新的实测证据&lt;br&gt;与真实基线和模拟预测比较；重跑旧 Sim 无法验证新代码&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#AA6325;fillColor=#FFF8EE;fontSize=25;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="tools">
          <mxGeometry x="925" y="80" width="720" height="150" as="geometry" />
        </mxCell>
        <mxCell id="decision" value="&lt;b&gt;Orchestrator 分析新证据并决策&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:21px;color:#51647B;'&gt;是否满足目标？收益是否可信？差异来自哪里？&lt;br&gt;保留 / 拒绝 / 补证据；需要修改则发出新的明确任务&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#2864BC;fillColor=#EAF1FF;fontSize=26;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="1">
          <mxGeometry x="650" y="935" width="600" height="115" as="geometry" />
        </mxCell>
        <mxCell id="sim_label" value="Analyzer：新的仿真证据" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=19;fontColor=#087E83;fontStyle=0;fontFamily=Arial Unicode MS;" vertex="1" parent="1">
          <mxGeometry x="490" y="855" width="270" height="32" as="geometry" />
        </mxCell>
        <mxCell id="real_label" value="benchmark / profile：实测证据" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontColor=#AA6325;fontStyle=0;fontFamily=Arial Unicode MS;" vertex="1" parent="1">
          <mxGeometry x="1030" y="855" width="280" height="32" as="geometry" />
        </mxCell>
        <mxCell id="feedbacklabel" value="反馈：修复本轮实现，或规划下一轮优化" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=21;fontColor=#2864BC;fontStyle=1;fontFamily=Arial Unicode MS;" vertex="1" parent="1">
          <mxGeometry x="115" y="925" width="500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="exit" value="&lt;b&gt;完成 / 请求必要输入&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:19px;color:#51647B;'&gt;给出结果与证据&lt;br&gt;或指出实际阻塞项&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#2864BC;fillColor=#FFFFFF;fontSize=23;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="1">
          <mxGeometry x="1420" y="945" width="280" height="95" as="geometry" />
        </mxCell>
        <mxCell id="modes" value="Implementer 可按需拆子 Agent；&lt;br&gt;single 模式由一个 Assistant 承担两种职责。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontColor=#51647B;fontStyle=0;fontFamily=Arial Unicode MS;" vertex="1" parent="1">
          <mxGeometry x="120" y="1040" width="500" height="45" as="geometry" />
        </mxCell>
        <mxCell id="foot" value="这是角色运行时 + 按任务选择的验证流程示意，不是硬编码 DAG。纯查询或已有充分证据时，无需机械重跑；新优化假设回到下一轮 Tick。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=17;fontColor=#51647B;fontStyle=0;fontFamily=Arial Unicode MS;" vertex="1" parent="1">
          <mxGeometry x="55" y="1110" width="1690" height="34" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
