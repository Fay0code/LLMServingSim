        <mxCell id="cli" value="&lt;b&gt;Provider CLI 通用工具&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:20px;color:#51647B;'&gt;读写文件 / 搜索 / shell / Git / 子代理&lt;br&gt;具体能力随 Codex / Claude 配置而定&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#2864BC;fillColor=#FFFFFF;fontSize=25;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="toolpanel">
