        <mxCell id="title" value="Skills 指导怎么做；工具真正执行与计算" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=38;fontColor=#152C48;fontStyle=1;fontFamily=Arial Unicode MS;" vertex="1" parent="1">
          <mxGeometry x="55" y="25" width="1690" height="62" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="固定版本中 Sim/skills 有 44 个 SKILL.md。另有 Agent/SKILL.md，供外部 Agent 调用 HTTP API。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontColor=#51647B;fontStyle=0;fontFamily=Arial Unicode MS;" vertex="1" parent="1">
          <mxGeometry x="55" y="95" width="1690" height="48" as="geometry" />
        </mxCell>
        <mxCell id="entry" value="&lt;b&gt;入口：skills/skill-of-skills/SKILL.md&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:21px;color:#51647B;'&gt;Agent 先读技能地图，再选择最高匹配工作流；skills 通过链接暴露给 provider CLI&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#8051B3;fillColor=#F7F2FC;fontSize=27;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="1">
          <mxGeometry x="55" y="175" width="1690" height="85" as="geometry" />
        </mxCell>
        <mxCell id="cat0" value="&lt;b&gt;top-*  × 6&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:18px;color:#51647B;'&gt;主要任务入口&lt;br&gt;加模型 / 加 kernel / 对齐 / 优化&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#8051B3;fillColor=#FFFFFF;fontSize=25;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="1">
          <mxGeometry x="55" y="330" width="310" height="145" as="geometry" />
        </mxCell>
        <mxCell id="cat1" value="&lt;b&gt;orchestrator-*  × 2&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:18px;color:#51647B;'&gt;规划与验证&lt;br&gt;Python profiling / Rust 接线&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#8051B3;fillColor=#FFFFFF;fontSize=25;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="1">
          <mxGeometry x="400" y="330" width="310" height="145" as="geometry" />
        </mxCell>
        <mxCell id="cat2" value="&lt;b&gt;impl-*  × 8&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:18px;color:#51647B;'&gt;叶子实现&lt;br&gt;注册 / 组合 / 接线 / 验证&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#8051B3;fillColor=#FFFFFF;fontSize=25;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="1">
          <mxGeometry x="745" y="330" width="310" height="145" as="geometry" />
        </mxCell>
        <mxCell id="cat3" value="&lt;b&gt;operate-*  × 11&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:18px;color:#51647B;'&gt;执行与查询&lt;br&gt;仿真 / 分析 / profile / 对齐&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#8051B3;fillColor=#FFFFFF;fontSize=25;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="1">
          <mxGeometry x="1090" y="330" width="310" height="145" as="geometry" />
        </mxCell>
        <mxCell id="cat4" value="&lt;b&gt;dev-*  × 15&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:18px;color:#51647B;'&gt;工程操作&lt;br&gt;测试 / worktree / 子代理协作&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#8051B3;fillColor=#FFFFFF;fontSize=25;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="1">
          <mxGeometry x="1435" y="330" width="310" height="145" as="geometry" />
        </mxCell>
        <mxCell id="other" value="另外 2 个：skill-of-skills 与 add-analyzer-subject。技能分类不是顺序必经的五个阶段，也不是五个 Agent。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=21;fontColor=#51647B;fontStyle=0;fontFamily=Arial Unicode MS;" vertex="1" parent="1">
          <mxGeometry x="55" y="490" width="1690" height="36" as="geometry" />
        </mxCell>
        <mxCell id="toolpanellabel" value="Agent 使用的真实工具入口" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=25;fontColor=#087E83;fontStyle=1;fontFamily=Arial Unicode MS;" vertex="1" parent="toolpanel">
          <mxGeometry x="22" y="15" width="1646" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cli" value="&lt;b&gt;Provider CLI 通用工具&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:20px;color:#51647B;'&gt;读写文件 / 搜索 / shell / Git / 子代理&lt;br&gt;具体能力随 Codex / Claude 配置而定&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#2864BC;fillColor=#FFFFFF;fontSize=25;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="toolpanel">
          <mxGeometry x="30" y="80" width="500" height="140" as="geometry" />
        </mxCell>
        <mxCell id="mcp" value="&lt;b&gt;Analyzer MCP：一个读工具&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:19px;color:#51647B;'&gt;read_analyzer_resource(path, source)&lt;br&gt;source = host | workspace；只读 GET&lt;br&gt;返回数值结果及适用的引用信息&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#087E83;fillColor=#FFFFFF;fontSize=24;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="toolpanel">
          <mxGeometry x="595" y="80" width="500" height="140" as="geometry" />
        </mxCell>
        <mxCell id="commands" value="&lt;b&gt;Shell 调用工程程序&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:19px;color:#51647B;'&gt;uv run python -m launcher …&lt;br&gt;alignment / profiling / tests / benchmark&lt;br&gt;这些不是新的 Agent&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#087E83;fillColor=#FFFFFF;fontSize=24;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="toolpanel">
          <mxGeometry x="1160" y="80" width="500" height="140" as="geometry" />
        </mxCell>
        <mxCell id="layerslabel" value="Sim 内部：测量时间向上组合，调度状态位于高层" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=25;fontColor=#6B7484;fontStyle=1;fontFamily=Arial Unicode MS;" vertex="1" parent="layers">
          <mxGeometry x="22" y="15" width="1646" height="40" as="geometry" />
        </mxCell>
        <mxCell id="layer0" value="&lt;b&gt;L1 Kernel&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:20px;color:#51647B;'&gt;测量 / 查表&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#6B7484;fillColor=#FFFFFF;fontSize=20;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="layers">
          <mxGeometry x="25" y="75" width="215" height="95" as="geometry" />
        </mxCell>
        <mxCell id="layer1" value="&lt;b&gt;L2 Op&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:20px;color:#51647B;'&gt;组合 kernel&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#6B7484;fillColor=#FFFFFF;fontSize=20;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="layers">
          <mxGeometry x="264" y="75" width="215" height="95" as="geometry" />
        </mxCell>
        <mxCell id="layer2" value="&lt;b&gt;L3 Worklet&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:20px;color:#51647B;'&gt;组合操作&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#6B7484;fillColor=#FFFFFF;fontSize=20;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="layers">
          <mxGeometry x="503" y="75" width="215" height="95" as="geometry" />
        </mxCell>
        <mxCell id="layer3" value="&lt;b&gt;L4 Model&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:20px;color:#51647B;'&gt;CostTree&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#6B7484;fillColor=#FFFFFF;fontSize=20;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="layers">
          <mxGeometry x="742" y="75" width="215" height="95" as="geometry" />
        </mxCell>
        <mxCell id="layer4" value="&lt;b&gt;L5 Worker&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:20px;color:#51647B;'&gt;KV / 组批&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#6B7484;fillColor=#FFFFFF;fontSize=20;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="layers">
          <mxGeometry x="981" y="75" width="215" height="95" as="geometry" />
        </mxCell>
        <mxCell id="layer5" value="&lt;b&gt;L6 Orchestrator&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:20px;color:#51647B;'&gt;请求路由&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#6B7484;fillColor=#FFFFFF;fontSize=20;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="layers">
          <mxGeometry x="1220" y="75" width="215" height="95" as="geometry" />
        </mxCell>
        <mxCell id="layer6" value="&lt;b&gt;L7 Infrastructure&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:20px;color:#51647B;'&gt;事件 / trace&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#6B7484;fillColor=#FFFFFF;fontSize=20;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="layers">
          <mxGeometry x="1459" y="75" width="215" height="95" as="geometry" />
        </mxCell>
        <mxCell id="foot" value="注意：L6 Orchestrator 是模拟的请求路由程序，不是蓝色的 LLM Orchestrator Agent。Analyzer 独立读取仿真产物，不参与该事件循环。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=17;fontColor=#51647B;fontStyle=0;fontFamily=Arial Unicode MS;" vertex="1" parent="1">
