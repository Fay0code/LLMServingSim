        <mxCell id="agent_eval" value="&lt;b&gt;Agent 能力测试&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:18px;color:#51647B;'&gt;tools/eval 跑隔离任务；testcases 提供 rubric，未见内置自动综合打分&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#087E83;fillColor=#FFFFFF;fontSize=23;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="eval">
          <mxGeometry x="25" y="80" width="775" height="75" as="geometry" />
        </mxCell>
        <mxCell id="sim_eval" value="&lt;b&gt;仿真 fidelity 验证&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:19px;color:#51647B;'&gt;alignment：真实 profile / iteration / E2E 与模拟预测比较&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.8;strokeColor=#087E83;fillColor=#FFFFFF;fontSize=23;fontColor=#152C48;fontFamily=Arial Unicode MS;" vertex="1" parent="eval">
          <mxGeometry x="25" y="180" width="775" height="75" as="geometry" />
